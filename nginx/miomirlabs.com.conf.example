# Reference copy of the performance directives for miomirlabs.com.
# The live config is on the VPS at /etc/nginx/sites-available/miomirlabs.com
# and is NOT deployed from this repo. This file exists so the settings are
# reviewable alongside the site. Apply changes by editing the server block on
# the VPS, then: nginx -t && systemctl reload nginx
#
# nginx ignores .htaccess entirely, so caching and compression must live here.

# Security headers. The site serves no third-party assets, so the CSP is strict.
# script-src 'self' works because all JS lives in assets/js/main.js; do not add
# inline <script> or style attributes to the HTML without loosening this.
#
# IMPORTANT: nginx add_header does not inherit. A location block that sets any
# add_header of its own drops every server-level header, so these are repeated
# in each location that sets Cache-Control. Keep them in sync.

server {
    server_name miomirlabs.com www.miomirlabs.com;
    root /var/www/miomirlabs.com/docs;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;

    # Compression. woff2 is already compressed; do not add it.
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css text/xml application/javascript
               application/json image/svg+xml application/xml;

    # Fonts are subset and stable; cache hard.
    location ~* \.woff2$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    }

    location ~* \.(css|png|svg|ico)$ {
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    }

    # HTML stays uncached so copy edits appear on refresh.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    }

    # Keep the repo checkout out of reach. root is docs/, so .git and the
    # markdown files already sit outside the docroot, but be explicit.
    location ~ /\.git { deny all; }
}
